{
  "name": "streamed",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "npm --workspace streamed-tv start",
    "dev": "npm --workspace streamed-tv run dev",
    "build": "npm --workspace streamed-tv run build",
    "check": "npm --workspace streamed-tv run check",
    "test": "node --test tests/*.test.js && npm --workspace streamed-tv test",
    "test:browser": "npm --workspace streamed-tv run test:browser",
    "test:legacy": "npm --workspace streamed-tv run test:legacy",
    "test:dotnet": "dotnet test tests/Streamed.Core.Tests/Streamed.Core.Tests.csproj",
    "sandbox": "node scripts/sandbox.js",
    "screenshots": "node scripts/screenshots.js",
    "build:webos": "node apps/webos/scripts/build-webos.js"
  },
  "devDependencies": {
    "@webos-tools/cli": "3.2.6",
    "hls.js": "1.7.3"
  }
}
