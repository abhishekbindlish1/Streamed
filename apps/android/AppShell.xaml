<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:StreamedTv.Views"
       x:Class="StreamedTv.AppShell"
       Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False" FlyoutBehavior="Disabled">
    <ShellItem x:Name="LoginRoot" Route="LoginPage">
        <ShellSection><ShellContent ContentTemplate="{DataTemplate views:LoginPage}" /></ShellSection>
    </ShellItem>
    <ShellItem x:Name="CatalogRoot" Route="MainPage">
        <ShellSection><ShellContent ContentTemplate="{DataTemplate views:MainPage}" /></ShellSection>
    </ShellItem>
</Shell>
