<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="StreamedTv.Views.PlayerPage"
             BackgroundColor="#000000"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="*,Auto">
        <toolkit:MediaElement x:Name="NativePlayer" Grid.Row="0" IsVisible="False"
                              ShouldAutoPlay="True" ShouldShowPlaybackControls="True" ShouldKeepScreenOn="True"
                              Aspect="AspectFit"/>
        <WebView x:Name="EmbedPlayer" Grid.Row="0" IsVisible="False" BackgroundColor="#000000"
                 Navigated="OnWebNavigated" Navigating="OnWebNavigating"/>
        <VerticalStackLayout Grid.Row="1" BackgroundColor="#1a1a1a" Padding="16,8" Spacing="4">
            <Label x:Name="StreamTitleLabel" Text="Stream" TextColor="#cccccc" FontSize="14" VerticalOptions="Center"/>
            <Label x:Name="PlaybackStatus" Text="Loading…" TextColor="#cccccc" FontSize="14"/>
            <HorizontalStackLayout Spacing="16">
                <Button x:Name="BackBtn" Text="Back" TextColor="White" BackgroundColor="#333333" Clicked="OnBackClicked"/>
                <Button x:Name="PlayPauseBtn" Text="Pause" TextColor="White" BackgroundColor="#333333" Clicked="OnPlayPauseClicked"/>
                <Button x:Name="RetryBtn" Text="Retry" IsVisible="False" TextColor="White" BackgroundColor="#333333" Clicked="OnRetryClicked"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
