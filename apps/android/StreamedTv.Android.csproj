<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <RootNamespace>StreamedTv</RootNamespace>
    <AssemblyName>StreamedTv.Android</AssemblyName>
    <ApplicationId>com.streamed.tv.android</ApplicationId>
    <ApplicationVersion>3</ApplicationVersion>
    <ApplicationDisplayVersion>1.1.1</ApplicationDisplayVersion>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifiers Condition="'$(RuntimeIdentifier)' == '' and '$(RuntimeIdentifiers)' == '' and '$(SandboxMode)' != 'true'">android-arm;android-arm64</RuntimeIdentifiers>
    <RuntimeIdentifiers Condition="'$(RuntimeIdentifier)' == '' and '$(RuntimeIdentifiers)' == '' and '$(SandboxMode)' == 'true'">android-x86;android-x64</RuntimeIdentifiers>
    <AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SandboxMode)' == 'true'">
    <DefineConstants>$(DefineConstants);SANDBOX</DefineConstants>
    <ApplicationId>com.streamed.tv.android.sandbox</ApplicationId>
  </PropertyGroup>
  <Target Name="RejectReleaseSandbox" BeforeTargets="PrepareForBuild" Condition="'$(SandboxMode)' == 'true' and '$(Configuration)' != 'Debug'">
    <Error Text="Sandbox mode is only allowed for Debug builds." />
  </Target>
  <PropertyGroup Condition="'$(SandboxPairing)' == 'true'">
    <DefineConstants>$(DefineConstants);SANDBOX_PAIRING</DefineConstants>
    <ApplicationId>com.streamed.tv.android.sandbox.pairing</ApplicationId>
  </PropertyGroup>
  <Target Name="RejectInvalidPairingFixture" BeforeTargets="PrepareForBuild" Condition="'$(SandboxPairing)' == 'true' and ('$(SandboxMode)' != 'true' or '$(Configuration)' != 'Debug')">
    <Error Text="Pairing fixtures require an explicit Debug sandbox build." />
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.120" />
    <PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <MauiAsset Include="Resources/Raw/**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
